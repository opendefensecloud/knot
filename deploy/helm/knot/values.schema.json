{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knot Helm values",
  "type": "object",
  "required": ["image", "database", "session"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "database": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "existingSecretName": { "type": "string" },
        "existingSecretKey": { "type": "string" }
      },
      "anyOf": [
        { "required": ["url"], "properties": { "url": { "minLength": 1 } } },
        { "required": ["existingSecretName"], "properties": { "existingSecretName": { "minLength": 1 } } }
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "existingSecretName": { "type": "string" },
        "existingSecretKey": { "type": "string" }
      },
      "anyOf": [
        { "required": ["key"], "properties": { "key": { "minLength": 1 } } },
        { "required": ["existingSecretName"], "properties": { "existingSecretName": { "minLength": 1 } } }
      ]
    },
    "oidc": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string" },
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" },
        "redirectUrl": { "type": "string" },
        "autoProvision": { "enum": ["off", "always", "domain", "group"] },
        "allowedDomains": { "type": "string" },
        "roleFromGroups": { "type": "string" },
        "extraAudiences": { "type": "string" },
        "existingSecretName": { "type": "string" }
      }
    },
    "baseUrl": { "type": "string" },
    "logLevel": { "enum": ["trace", "debug", "info", "warn", "error"] },
    "logFormat": { "enum": ["json", "pretty"] },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer" },
        "targetPort": { "type": "integer" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "metricsIngressFrom": { "type": "array" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" }
      }
    },
    "alerting": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "pageSeverity": { "type": "string" },
        "ticketSeverity": { "type": "string" },
        "errorBudgetTarget": { "type": "number", "minimum": 0, "maximum": 1 },
        "latencyP95Target": { "type": "number", "minimum": 0 },
        "rateLimitedPerSecond": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "tracing": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "otlpEndpoint": { "type": "string" }
      }
    },
    "blob": {
      "type": "object",
      "properties": {
        "backend": { "enum": ["postgres", "s3"] },
        "s3": { "type": "object" }
      }
    },
    "archive": {
      "type": "object",
      "properties": {
        "retentionDays": { "type": "integer", "minimum": 1 }
      }
    },
    "history": {
      "type": "object",
      "properties": {
        "workers": { "type": "integer", "minimum": 0 },
        "replayMaxBytes": { "type": "integer", "minimum": 1048576 },
        "cpuShare": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "collabMaxSockets": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "trustedProxies": {
      "description": "IPs or CIDRs whose X-Forwarded-For is trusted, as a list or one comma-separated string. Only IP and CIDR characters are allowed, and a prefix length of 0 (0.0.0.0/0, ::/0, /00) is refused; knot checks the rest at startup (malformed entries, host bits after the prefix, IPv4-mapped networks).",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\s*[0-9A-Fa-f:.]+(/[0-9]+)?\\s*$",
            "not": { "pattern": "/\\s*0+\\s*$" }
          }
        },
        {
          "type": "string",
          "pattern": "^[0-9A-Fa-f:.,/\\s]*$",
          "not": { "pattern": "/\\s*0+\\s*(,|$)" }
        }
      ]
    },
    "quotas": {
      "type": "object",
      "properties": {
        "pagesPerUser": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "pagesPerWorkspace": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "blobBytesPerUser": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "blobBytesPerWorkspace": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
